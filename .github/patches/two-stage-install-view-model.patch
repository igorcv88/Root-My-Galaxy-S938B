+    private fun publishInstalledState(probe: String) {
+        val bootId = currentBootToken()
+        if (bootId != null && AppPreferences.isReZygiskPending(app, bootId)) {
+            if (!ReZygiskLateLoad.hasAuthorizedRoot(app)) {
+                ReZygiskLateLoad.requestRootAuthorization(app)
+                mutableState.value = InstallUiState(
+                    phase = InstallPhase.AwaitingRootGrant,
+                    message = app.getString(R.string.status_rezygisk_root_required),
+                    probeOutput = probe,
+                    log = "$probe\n${app.getString(R.string.log_rezygisk_permission_required)}",
+                )
+                return
+            }
+
+            when (val runtime = ReZygiskLateLoad.runtimeState(app)) {
+                ReZygiskRuntimeState.Success -> {
+                    AppPreferences.markReZygiskActive(app, bootId)
+                    mutableState.value = InstallUiState(
+                        phase = InstallPhase.ReZygiskActive,
+                        message = app.getString(R.string.status_rezygisk_active),
+                        probeOutput = probe,
+                        log = "$probe\n${app.getString(R.string.log_rezygisk_verified)}",
+                    )
+                }
+                ReZygiskRuntimeState.Pending -> {
+                    mutableState.value = InstallUiState(
+                        phase = InstallPhase.PreparingReZygisk,
+                        message = app.getString(R.string.status_soft_reboot_scheduled),
+                        probeOutput = probe,
+                        log = "$probe\n${app.getString(R.string.log_soft_reboot_scheduled)}",
+                    )
+                }
+                is ReZygiskRuntimeState.Failed -> {
+                    mutableState.value = InstallUiState(
+                        phase = InstallPhase.ReZygiskFailed,
+                        message = app.getString(R.string.status_rezygisk_failed),
+                        probeOutput = probe,
+                        log = "$probe\n[-] ${runtime.message}",
+                    )
+                }
+                ReZygiskRuntimeState.None -> {
+                    mutableState.value = InstallUiState(
+                        phase = InstallPhase.ReZygiskReady,
+                        message = app.getString(R.string.status_rezygisk_ready),
+                        probeOutput = probe,
+                        log = "$probe\n${app.getString(R.string.log_rezygisk_ready)}",
+                    )
+                }
+            }
+            return
+        }
+
+        val reZygiskActive = bootId != null && AppPreferences.isReZygiskActive(app, bootId)
+        mutableState.value = InstallUiState(
+            phase = if (reZygiskActive) InstallPhase.ReZygiskActive else InstallPhase.Installed,
+            message = app.getString(
+                if (reZygiskActive) R.string.status_rezygisk_active else R.string.status_ksu_active,
+            ),
+            probeOutput = probe,
+            log = probe,
+        )
+    }
